prefer-no-csd

layout {
    gaps 4
    center-focused-column "on-overflow"
    always-center-single-column

    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width {
        proportion 0.5
    }

    struts {
        // Change left to 0 and top to -2 if you used side bar
        left -2
        right -2
        top 0
        bottom -2
    }

    focus-ring {
        width 0.25
        active-color "#ecedf1"
        inactive-color "#00000000"
    }

    border { off; }

    shadow {
        on
        softness 20
        spread 4
        offset x=0 y=4
        color "#00000080"
    }
}