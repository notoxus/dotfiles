window-rule {
    geometry-corner-radius 14
    draw-border-with-background false
    clip-to-geometry true
}

// Keep Firefox picture-in-picture floating.
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=24 y=24 relative-to="bottom-right"
}
window-rule {
    match app-id="^soffice$"
    match app-id="^libreoffice-"
    open-floating true
}

// if you use steam you will probably like these
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    opacity 0.9
}

layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}
