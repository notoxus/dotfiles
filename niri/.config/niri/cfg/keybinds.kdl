binds {

    // ────────────── Keybindings ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

    // ─── Noctalia v5 keybinds ───
    // https://docs.noctalia.dev/noctalia/ipc/

    Mod+Shift+ESCAPE                     { show-hotkey-overlay; }

    // ─── Applications ───
    CTRL+Alt+T                          hotkey-overlay-title="Open Terminal: Ghostty" { spawn "ghostty"; }
    Alt+F2                              hotkey-overlay-title="Run Command: Noctalia" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Space                           hotkey-overlay-title="Run Command: Noctalia" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+B                               hotkey-overlay-title="Open Browser: firefox" { spawn "firefox"; }
    Mod+ALT+L                           hotkey-overlay-title="Lock Screen: Noctalia" { spawn-sh "noctalia msg session lock"; }
    Mod+Shift+Q                         hotkey-overlay-title="Session Menu: Noctalia" { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+V                               hotkey-overlay-title="Open Clipboard History" { spawn-sh "cliphist list | fuzzel --dmenu --with-nth 2 | cliphist decode | wl-copy"; }
    Mod+E                               hotkey-overlay-title="File Manager: Thunar" { spawn "thunar"; }
    Ctrl+Escape                         hotkey-overlay-title="System Activity: btop" { spawn "ghostty" "-e" "btop"; }
    // ─── Media Controls ───
    XF86AudioRaiseVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute                       allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext                       allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev                       allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay                       allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause                      allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }

    // ─── Brightness Controls ───
    XF86MonBrightnessUp                 allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown               allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
    // Display
    Mod+P                               hotkey-overlay-title="Display Mode" { spawn-sh "$HOME/.local/bin/display-mode"; }
    Mod+Alt+P                           hotkey-overlay-title="Refresh Rate"   { spawn-sh "$HOME/.local/bin/display-refresh"; }
    // ─── Window Movement and Focus ───
    // Niri handles these mouse gestures natively:
    // Mod + left-drag moves a window; Mod + right-drag resizes it.
    Alt+F4                              hotkey-overlay-title="Close Window" { close-window; }

    Mod+H                               { focus-column-left; }
    Mod+Alt+Left                        { focus-column-left; }
    Mod+L                               { focus-column-right; }
    Mod+Alt+Right                       { focus-column-right; }
    Mod+K                               { focus-window-up; }
    Mod+Alt+Up                          { focus-window-up; }
    Mod+J                               { focus-window-down; }
    Mod+Alt+Down                        { focus-window-down; }
    
    Alt+Tab                             hotkey-overlay-title="Last Window" { focus-window-previous; }
    Mod+CTRL+Left                       { move-column-left; }
    Mod+CTRL+H                          { move-column-left; }
    Mod+CTRL+Right                      { move-column-right; }
    Mod+CTRL+L                          { move-column-right; }
    Mod+CTRL+UP                         { move-window-up; }
    Mod+CTRL+K                          { move-window-up; }
    Mod+CTRL+Down                       { move-window-down; }
    Mod+CTRL+J                          { move-window-down; }

    Mod+Home                            { focus-column-first; }
    Mod+End                             { focus-column-last; }
    Mod+CTRL+Home                       { move-column-to-first; }
    Mod+CTRL+End                        { move-column-to-last; }

    Mod+Shift+Left                      { focus-monitor-left; }
    Mod+Shift+Right                     { focus-monitor-right; }
    Mod+Shift+UP                        { focus-monitor-up; }
    Mod+Shift+Down                      { focus-monitor-down; }

    Mod+Shift+CTRL+Left                 { move-column-to-monitor-left; }
    Mod+Shift+CTRL+Right                { move-column-to-monitor-right; }
    Mod+Shift+CTRL+UP                   { move-column-to-monitor-up; }
    Mod+Shift+CTRL+Down                 { move-column-to-monitor-down; }

    // ─── Workspace Switching ───
    Mod+WheelScrollDown                 cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp                   cooldown-ms=150 { focus-workspace-up; }
    Ctrl+F1                             { focus-workspace 1; }
    Ctrl+F2                             { focus-workspace 2; }
    Ctrl+F3                             { focus-workspace 3; }
    Ctrl+F4                             { focus-workspace 4; }
    Ctrl+F5                             { focus-workspace 5; }
    Ctrl+F6                             { focus-workspace 6; }
    Ctrl+F7                             { focus-workspace 7; }
    Ctrl+F8                             { focus-workspace 8; }
    Ctrl+F9                             { focus-workspace 9; }
    Mod+CTRL+WheelScrollDown            cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+CTRL+WheelScrollUp              cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight                { focus-column-right; }
    Mod+WheelScrollLeft                 { focus-column-left; }
    Mod+CTRL+WheelScrollRight           { move-column-right; }
    Mod+CTRL+WheelScrollLeft            { move-column-left; }

    Mod+Shift+WheelScrollDown           { focus-column-right; }
    Mod+Shift+WheelScrollUp             { focus-column-left; }
    Mod+CTRL+Shift+WheelScrollDown      { move-column-right; }
    Mod+CTRL+Shift+WheelScrollUp        { move-column-left; }

    Mod+CTRL+1                          { move-column-to-workspace 1; }
    Mod+CTRL+2                          { move-column-to-workspace 2; }
    Mod+CTRL+3                          { move-column-to-workspace 3; }
    Mod+CTRL+4                          { move-column-to-workspace 4; }
    Mod+CTRL+5                          { move-column-to-workspace 5; }
    Mod+CTRL+6                          { move-column-to-workspace 6; }
    Mod+CTRL+7                          { move-column-to-workspace 7; }
    Mod+CTRL+8                          { move-column-to-workspace 8; }
    Mod+CTRL+9                          { move-column-to-workspace 9; }

    Mod+TAB                             hotkey-overlay-title="Previous Workspace" { focus-workspace-previous; }

    // ─── Layout Controls ───
    Mod+CTRL+F                          hotkey-overlay-title="Expand Column to Available Width" { expand-column-to-available-width; }
    Mod+C                               hotkey-overlay-title="Center Column" { center-column; }
    Mod+CTRL+C                          hotkey-overlay-title="Center Visible Columns" { center-visible-columns; }
    Mod+Comma                           hotkey-overlay-title="Pull window into column" { consume-or-expel-window-left; }
    Mod+Period                          hotkey-overlay-title="Push window out of column" { consume-or-expel-window-right; }
    Mod+R                               hotkey-overlay-title="Cycle preset column width" { switch-preset-column-width; }
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Equal                           { set-column-width "+10%"; }
    Mod+Shift+Minus                     { set-window-height "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }

    // ─── Modes ───
    Mod+T                               hotkey-overlay-title="Toggle Floating Window" { toggle-window-floating; }
    Mod+Shift+T                         hotkey-overlay-title="Switch Focus: Tiling / Floating" { switch-focus-between-floating-and-tiling; }
    Mod+M                               hotkey-overlay-title="Zoom / Restore Window" { maximize-window-to-edges; }
    Mod+F                               hotkey-overlay-title="Toggle Fullscreen" { fullscreen-window; }
    Mod+W                               hotkey-overlay-title="Toggle Tabbed Column" { toggle-column-tabbed-display; }

    // ─── Screenshots ───
    Mod+Shift+S                        hotkey-overlay-title="Screenshot Region" { screenshot; }
    Print                              hotkey-overlay-title="Screenshot Screen" { screenshot-screen; }
    Alt+Print                          hotkey-overlay-title="Screenshot Window" { screenshot-window; }

    // ─── Emergency Escape Key ───
    // Use this when a fullscreen app blocks your keybinds.
    // It disables any active keyboard shortcut inhibitor, restoring control.
    Mod+ESCAPE                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ─── Exit / Power ───
    CTRL+ALT+Delete                     hotkey-overlay-title="Exit Niri" { quit; }
    Mod+Shift+P                         hotkey-overlay-title="Power Off Monitors" { power-off-monitors; }
    CTRL+F10                            repeat=false hotkey-overlay-title="Toggle Overview" { toggle-overview; }
}
