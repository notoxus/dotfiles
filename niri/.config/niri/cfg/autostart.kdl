// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

    spawn-at-startup "noctalia"
    spawn-sh-at-startup "$HOME/.local/bin/noctalia-media-island"
    spawn-sh-at-startup "fcitx5 -d"
    spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
    spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
    // Noctalia v5 provides the polkit agent enabled in config.toml.
    // Avoid starting a second distro-specific agent here.
