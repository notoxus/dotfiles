#!/usr/bin/env bash

set -euo pipefail

mapfile -t all < <(niri msg --json outputs | jq -r 'keys[]')

internal=""
for o in "${all[@]}"; do
  [[ $o =~ ^(eDP|LVDS|DSI) ]] && { internal=$o; break; }
done
[[ -n $internal ]] || internal="${all[0]}"   # desktop PC: treat the first as primary

externals=()
for o in "${all[@]}"; do
  [[ $o != "$internal" ]] && externals+=("$o")
done
if (( ${#externals[@]} == 0 )); then
  echo "No external display connected." >&2
  exit 0
fi

choice="$(printf '%s\n' 'PC screen only' 'Duplicate' 'Extend' 'Second screen only' \
  | fuzzel --dmenu -p 'Display: ')" || exit 0

pkill -x wl-mirror 2>/dev/null || true

on_all()  { niri msg output "$internal" on; for e in "${externals[@]}"; do niri msg output "$e" on; done; }

case "$choice" in
  'PC screen only')
    niri msg output "$internal" on
    for e in "${externals[@]}"; do niri msg output "$e" off; done ;;
  'Second screen only')
    for e in "${externals[@]}"; do niri msg output "$e" on; done
    niri msg output "$internal" off ;;
  'Extend')
    on_all ;;
  'Duplicate')
    on_all
    for e in "${externals[@]}"; do
      wl-mirror --fullscreen --fullscreen-output "$e" "$internal" &
    done ;;
esac