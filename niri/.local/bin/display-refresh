#!/usr/bin/env bash

set -euo pipefail

persist_mode() {
  local out="$1" mode="$2" file tmp
  file="${DISPLAY_KDL:-${XDG_CONFIG_HOME:-$HOME/.config}/niri/cfg/display.kdl}"
  mkdir -p "$(dirname "$file")"
  touch "$file"
  tmp="$(mktemp)"
  awk -v out="$out" -v mode="$mode" '
    function count(s, c,   n, i) {
      n = 0
      for (i = 1; i <= length(s); i++) if (substr(s, i, 1) == c) n++
      return n
    }
    {
      line = $0; t = line; sub(/^[ \t]+/, "", t)
      if (t ~ /^\/\//) { print line; next }

      if (!inblk && t ~ ("^output[ \t]+\"" out "\"[ \t]*\\{[ \t]*$")) {
        inblk = 1; depth = 0; found = 1; hasmode = 0
      }
      if (!inblk) { print line; next }

      newdepth = depth + count(line, "{") - count(line, "}")
      if (depth == 1 && t ~ /^mode[ \t]+"/) {
        match(line, /^[ \t]*/)
        print substr(line, 1, RLENGTH) "mode \"" mode "\""
        hasmode = 1
      } else {
        if (newdepth <= 0 && !hasmode) { print "    mode \"" mode "\""; hasmode = 1 }
        print line
      }
      depth = newdepth
      if (depth <= 0) inblk = 0
    }
    END {
      if (!found) {
        print ""
        print "output \"" out "\" {"
        print "    mode \"" mode "\""
        print "}"
      }
    }
  ' "$file" > "$tmp" && cat "$tmp" > "$file"
  rm -f "$tmp"
}

out="$(niri msg --json focused-output | jq -r '.name')"
read -r w h < <(niri msg --json outputs | jq -r --arg o "$out" \
  '.[$o] as $x | $x.modes[$x.current_mode] | "\(.width) \(.height)"')

choice="$(niri msg --json outputs | jq -r --arg o "$out" --argjson w "$w" --argjson h "$h" \
  '.[$o].modes[] | select(.width == $w and .height == $h) | .refresh_rate' \
  | sort -rnu \
  | awk '{ printf "%.3f Hz\n", $1 / 1000 }' \
  | fuzzel --dmenu -p "Refresh (${out}): ")" || exit 0

mode="${w}x${h}@${choice% Hz}"
niri msg output "$out" mode "$mode"
persist_mode "$out" "$mode"