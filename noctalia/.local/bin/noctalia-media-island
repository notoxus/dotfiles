#!/usr/bin/env bash
# Briefly reveal Noctalia's media island when an MPRIS player changes state.

set -uo pipefail

readonly island_name="media-island"
readonly visible_seconds="1.5"
hide_pid=""

hide_island() {
  noctalia msg bar-hide "$island_name" >/dev/null 2>&1 || true
}

cancel_pending_hide() {
  if [[ -n "$hide_pid" ]] && kill -0 "$hide_pid" 2>/dev/null; then
    kill "$hide_pid" 2>/dev/null || true
    wait "$hide_pid" 2>/dev/null || true
  fi
  hide_pid=""
}

show_briefly() {
  cancel_pending_hide
  noctalia msg bar-show "$island_name" >/dev/null 2>&1 || return 0
  (
    sleep "$visible_seconds"
    hide_island
  ) &
  hide_pid=$!
}

cleanup() {
  cancel_pending_hide
  hide_island
}
trap cleanup EXIT INT TERM

# Noctalia and this watcher start together. Hide the island as soon as its IPC
# socket is ready so an empty surface never lingers after login.
for _ in {1..40}; do
  if noctalia msg bar-hide "$island_name" >/dev/null 2>&1; then
    break
  fi
  sleep 0.25
done

# Position is not normally emitted as PropertiesChanged. Keep a tiny bit of
# state from each complete D-Bus signal so the island is revealed for actual
# playback (and track changes while playback continues), but not when a player
# is merely paused or stopped.
playing=0
signal_block=""
while IFS= read -r line; do
  if [[ -z "$line" ]]; then
    if [[ "$signal_block" == *'string "PlaybackStatus"'* ]]; then
      if [[ "$signal_block" == *'string "Playing"'* ]]; then
        playing=1
      else
        playing=0
      fi
      [[ "$playing" == 1 ]] && show_briefly
    elif [[ "$playing" == 1 && "$signal_block" == *'string "Metadata"'* ]]; then
      show_briefly
    fi
    signal_block=""
    continue
  fi
  [[ "$line" == signal\ * ]] && signal_block="$line"
  [[ -n "$signal_block" && "$line" != signal\ * ]] && signal_block+=" $line"
done < <(
  dbus-monitor --session \
    "type='signal',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged',arg0='org.mpris.MediaPlayer2.Player'"
)
